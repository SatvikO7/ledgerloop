htmlcov/

# Generated datasets are reproducible from data/seeds.json — never committed.
data/generated/

# Reports and evaluation output are regenerated by `make eval`. That includes
# B2's response cache (reports/llm_cache_b2): a cache of stand-in answers under
# tests/fixtures/ would look like evidence of a live run, which is why B2 keeps
# its own directory here instead.
reports/

# EVALUATION.md is NOT ignored, from Phase 2.1. PLAN.md 16 names it as a
# deliverable, and a judge who clones without running `make eval` was seeing no
# metrics document at all. What ships is a snapshot of the generated file;
# `make eval` still regenerates it in place, two runs differ only in one labelled
# timings block, and a test enforces that -- so the committed copy is checkable
# rather than authoritative.

# Streamlit's local state. Never a project artefact.
.streamlit/

# Private development notes and per-step documentation. Never published.
# Includes every `.local/steps/step-NN-*.md` report -- they are working notes
# for the next session, not user documentation. What users need is in
# README.md, and what the numbers are is in EVALUATION.md.
.local/

# Internal planning and session documents. Kept on disk and actively used --
# PROGRESS.md is the session handoff and PLAN.md is the source of the §
# citations throughout the code -- but deliberately not published.
#
# ARCHITECTURE.md came OFF this list in Phase 2.1. PLAN.md 16 names it as a
# deliverable and its 51 numbered design decisions are the project's most
# load-bearing writing; leaving them unreadable to anyone who clones the repo
# was the single highest-cost omission the final audit found.
PLAN.md
IMPLEMENTATION_PLAN.md
PROGRESS.md

# Editor / tooling local state.
.claude/
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Personal presentation notes. Never pushed.
txt/

# Never commit secrets.
.env
.env.local
*.pem
*.key
